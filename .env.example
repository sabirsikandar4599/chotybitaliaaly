# Email (Brevo)
BREVO_API_KEY=
FROM_EMAIL=
TO_EMAIL=

# WhatsApp: number that receives website messages (country code, no +)
WHATSAPP_PHONE=923414717517

# Option A — CallMeBot (free, easiest). Get the key: https://www.callmebot.com/blog/free-api-whatsapp-messages/
