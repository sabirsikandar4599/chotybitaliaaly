# Option B — official WhatsApp Cloud API (Meta). Used instead of CallMeBot when set.
WA_TOKEN=
WA_PHONE_ID=
# Approved template with one {{1}} body variable (recommended)
WA_TEMPLATE=
WA_TEMPLATE_LANG=en
